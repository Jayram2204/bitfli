# bitfli.xyz Environment Configuration
# Default live execution mode (never silently masquerades mock responses as live on-chain txs)
DRY_RUN=false

# OutLayer TEE Agent Custody (https://api.outlayer.ai)
# Provision via: curl -X POST https://api.outlayer.ai/register -H "Content-Type: application/json" -d '{"name":"bitfli-pod-01","network":"near"}'
OUTLAYER_API_URL=https://api.outlayer.ai
OUTLAYER_API_KEY=
OUTLAYER_NEAR_ACCOUNT=

# NEAR Intents Agent API (https://api.agentsonintents.com/v1)
AGENT_API_URL=https://api.agentsonintents.com/v1
AGENT_ID=pod-01.bitfli.near
AGENT_API_KEY=

# NEAR Intents 1Click Swap API (https://1click.chaindefuser.com)
ONE_CLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=

# NEAR AI Cloud Inference (https://cloud-api.near.ai/v1)
NEAR_AI_API_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3-0324

# PingPay x402 Facilitator (https://facilitator.pingpay.io)
PINGPAY_FACILITATOR_URL=https://facilitator.pingpay.io
PINGPAY_PAY_TO_ADDRESS=0x71C98f4c1c00b17f1148a3e9129e2a0011223344

# NEAR Protocol RPC & Deployed Contract
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
NEAR_MAINNET_RPC_URL=https://free.rpc.fastnear.com
NEAR_CONTRACT_ID=bitfli-vault-67f5be.testnet
